{
  "name": "ecosyt",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.0.9",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "dev": "PATH=\"$PWD/bin:$PATH\" turbo run dev --parallel",
    "dev:web": "pnpm --filter @ecosyt/web dev",
    "dev:api": "pnpm --filter @ecosyt/api dev",
    "dev:sync": "pnpm --filter @ecosyt/sync-server dev",
    "build": "PATH=\"$PWD/bin:$PATH\" turbo run build",
    "lint": "PATH=\"$PWD/bin:$PATH\" turbo run lint",
    "format": "pnpm exec prettier . --write",
    "format:check": "pnpm exec prettier . --check",
    "typecheck": "PATH=\"$PWD/bin:$PATH\" turbo run typecheck",
    "test": "PATH=\"$PWD/bin:$PATH\" turbo run test --filter=!@ecosyt/e2e --filter=!@ecosyt/performance",
    "test:coverage": "pnpm coverage:report",
    "e2e": "pnpm --filter @ecosyt/e2e test",
    "bench": "pnpm --filter @ecosyt/performance bench",
    "db:migrate": "pnpm --filter @ecosyt/api db:migrate",
    "db:seed": "pnpm --filter @ecosyt/api db:seed",
    "setup": "bash scripts/setup.sh",
    "coverage:report": "pnpm exec vitest run tests/unit --coverage --coverage.provider=v8 --coverage.reporter=text-summary --coverage.reporter=json-summary --coverage.include='packages/{shared,ast,compiler,runtime,sync}/src/**/*.ts' --coverage.thresholds.lines=80 --coverage.thresholds.functions=80 --coverage.thresholds.statements=80 --coverage.thresholds.branches=80",
    "audit:deps": "pnpm audit --audit-level=high",
    "duplication:check": "pnpm exec jscpd --silent --min-lines 10 --min-tokens 50 --threshold 8 --reporters console --pattern '**/*.{ts,tsx}' --ignore '**/dist/**,**/*.d.ts' apps packages",
    "smells:check": "pnpm lint"
  },
  "devDependencies": {
    "@commitlint/cli": "21.0.0",
    "@commitlint/config-conventional": "21.0.0",
    "@eslint/js": "^10.0.1",
    "@semantic-release/changelog": "6.0.3",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/git": "10.0.1",
    "@semantic-release/github": "12.0.8",
    "@semantic-release/release-notes-generator": "14.1.1",
    "@types/node": "^25.6.2",
    "@vitest/coverage-v8": "^4.1.7",
    "esbuild": "^0.28.0",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^17.6.0",
    "jscpd": "4.1.0",
    "prettier": "^3.8.3",
    "semantic-release": "25.0.3",
    "tsx": "^4.22.3",
    "turbo": "^2.9.14",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.2",
    "vitest": "^4.1.5"
  }
}
